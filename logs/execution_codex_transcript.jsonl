{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"source .venv/bin/activate && python - <<'PY'\nimport pandas as pd, numpy as np\nraw = pd.read_csv('results/summaries/judgment_eval_raw.csv')\n\ndef boot(arr, n=10000):\n    rng=np.random.default_rng(42)\n    samp=rng.choice(arr,size=(n,len(arr)),replace=True).mean(axis=1)\n    return np.percentile(samp,[2.5,97.5])\n\nfor model in raw['model'].unique():\n    print('\\\\nMODEL', model)\n    for hint in ['no_hint','misleading_wrong_hint']:\n        sub = raw[(raw.model==model)&(raw.hint_condition==hint)]\n        base = sub[sub.condition=='neutral'].set_index(['dataset','example_id'])\n        print(' ', hint)\n        for cond in ['mild_skeptical_question','strong_judgment_question','strong_judgment_statement']:\n            cmp = sub[sub.condition==cond].set_index(['dataset','example_id'])\n            aligned = base.join(cmp[['is_correct','followed_hint','rationale_word_count']], rsuffix='_cmp', how='inner')\n            acc = (aligned['is_correct_cmp']-aligned['is_correct']).to_numpy()\n            rat = (aligned['rationale_word_count_cmp']-aligned['rationale_word_count']).to_numpy()\n            ci=boot(acc)\n            print(f'   {cond}: acc_delta={acc.mean():.3f} ci=({ci[0]:.3f},{ci[1]:.3f}) rat_delta={rat.mean():.3f}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
