{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"source .venv/bin/activate && python - <<'PY'\nimport pandas as pd\nraw = pd.read_csv('results/summaries/judgment_eval_raw.csv')\n# pooled summaries\nfor hint in ['no_hint','misleading_wrong_hint']:\n    df = raw[raw['hint_condition']==hint]\n    print('\\\\n', hint.upper())\n    s = df.groupby(['model','condition']).agg(acc=('is_correct','mean'), hint_follow=('followed_hint','mean'), rat=('rationale_word_count','mean'), conf=('confidence','mean')).reset_index()\n    print(s.to_string(index=False))\n\n# pooled objective over all models\nobj = raw[raw['hint_condition']=='no_hint']\nprint('\\\\nALL MODELS OBJECTIVE')\nprint(obj.groupby('condition').agg(acc=('is_correct','mean'), rat=('rationale_word_count','mean'), conf=('confidence','mean')).reset_index().to_string(index=False))\n\nhinted = raw[raw['hint_condition']=='misleading_wrong_hint']\nprint('\\\\nALL MODELS HINTED')\nprint(hinted.groupby('condition').agg(acc=('is_correct','mean'), hint_follow=('followed_hint','mean'), rat=('rationale_word_count','mean')).reset_index().to_string(index=False))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
